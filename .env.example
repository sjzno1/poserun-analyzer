# PoseRun Analyzer 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# Flask 配置
FLASK_ENV=production
FLASK_APP=app.py
SECRET_KEY=change-me-to-a-random-secret-key

# 最大上传文件大小 (字节) 50MB
MAX_CONTENT_LENGTH=52428800

# 端口配置
HOST=0.0.0.0
PORT=5000

# 视频处理配置
FRAME_SKIP=10
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5

# 模型配置
POSE_MODEL_SELECTION=1  # 0=轻量, 1=高精度

# 认证配置（可选）
# 首次启动自动创建默认管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 自定义用户库路径（默认 <项目目录>/data/auth.db）
# AUTH_DB_PATH=/path/to/auth.db
# 自定义令牌签名密钥（默认自动生成并持久化在 data/.auth_secret）
# AUTH_SECRET=